# ─────────────────────────────────────────────────────────────────────────────
# Front-end configuration. Normally generated by `contracts/scripts/deploy.js`.
# Copy to `.env.local` to point the site at a deployment by hand.
# ─────────────────────────────────────────────────────────────────────────────

# 101 = Solana mainnet-beta, 102 = Solana devnet, 31337 = local Hardhat
VITE_CHAIN_ID=102

# Public RPC used for read-only calls before a wallet is connected.
# Falls back to the chain default when empty.
VITE_RPC_URL=

# Deployed protocol addresses.
VITE_FEE_TOKEN=
VITE_FEE_TOKEN_DECIMALS=18
VITE_ART_TOKEN=
VITE_MINING_TOKEN=
VITE_MINING_POOL=
VITE_FEE_ROUTER=
VITE_ARTWORK_VAULT=
