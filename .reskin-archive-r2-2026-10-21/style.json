  "layout": {
    "id": "documentary",
    "name": "Documentary Ledger",
    "family": "editorial",
    "signature": [
      "masthead instead of app bar",
      "serif or high-contrast display voice with running-text rhythm",
      "numbered sections and marginalia",
      "tables styled as ledger rules, not cards",
      "navigation is an index line under the masthead"
    ],
    "navigation": "Masthead with the brand as a wordmark, route names as an index line, and a thin rule. No pills, no filled app bar, no sidebar.",
    "structure": [
      "masthead with issue/date line",
      "index line of routes",
      "hero statement spanning 9 columns",
      "two-column body: 7-column ledger + 3-column marginalia",
      "footnotes and colophon"
    ],
    "content_mapping": "Turn dashboard metrics into a lede paragraph with displayed figures. Tables become ledger rows with rules and tabular numerals. Forms become a typeset questionnaire. Keep every label and value; restyle hierarchy only.",
    "css_recipe": ".masthead{display:grid;grid-template-columns:1fr auto;align-items:end;border-bottom:2px solid var(--ink);padding-bottom:12px}.index{display:flex;gap:28px;border-bottom:1px solid var(--line);padding:12px 0;font:500 12px/1 var(--font-mono);letter-spacing:.12em;text-transform:uppercase}.body{display:grid;grid-template-columns:minmax(0,7fr) minmax(220px,3fr);gap:clamp(24px,5vw,72px)}.lede{font-size:clamp(2rem,4vw,4.6rem);line-height:.98}",
    "risks": [
      "serif font alone is not a skeleton change",
      "dense dashboards need tabular numerals and generous line-height"
    ],
    "not_interchangeable_with": [
      "dashboard-shell",
      "sidebar-workspace",
      "topnav-page"
    ]
  },
